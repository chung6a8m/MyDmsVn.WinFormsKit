<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net48'">app.net48.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(BusyOverlayNegativeManifest)' == 'true'">app.no-layered.manifest</ApplicationManifest>
    <RootNamespace>MyDmsVn.Bootstrap5WinFormUI.VisualStyleHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MyDmsVn.Bootstrap5WinFormUI\MyDmsVn.Bootstrap5WinFormUI.csproj" />
  </ItemGroup>
</Project>
